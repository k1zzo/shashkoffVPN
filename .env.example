# ── Required ──────────────────────────────────────────────────────────────────
APP_BASE_URL=https://vpn.your-domain.com
APP_TRUSTED_HOSTS=vpn.your-domain.com,localhost,127.0.0.1

VPN_SERVER=vpn.your-domain.com
VPN_PORT=443
VPN_SNI=www.cloudflare.com
VPN_REALITY_PUBLIC_KEY=PASTE_REAL_PUBLIC_KEY_HERE
VPN_REALITY_SHORT_ID=abcdef1234567890
VPN_TRANSPORT=tcp

# ── Optional (defaults shown) ─────────────────────────────────────────────────
# APP_NAME=SHASHKOFFVPN
# APP_ENV=production
# DATABASE_PATH=data/app.db
# VPN_PROFILE_NAME_PREFIX=SHASHKOFFVPN

# ── Happ server description (meta.serverDescription) ──────────
# Custom subtitle shown under the server name in the Happ UI
# (replaces "VLESS | TCP | Reality | JSON"). Max 30 characters.
# Docs: https://www.happ.su/main/dev-docs/app-management
#       (section "Server Description in Subscription")
HAPP_SERVER_DESCRIPTION=NL-1

# ── Happ: hide server settings UI ─────────────────────────────
# Sends the "hide-settings: 1" HTTP header so Happ disables
# server config viewing/editing for subscription users. Requires
# a valid providerid. Docs: https://www.happ.su/main/dev-docs/app-management
HAPP_HIDE_SERVER_SETTINGS=true

# ── Happ Limited Links (experimental, optional) ───────────────────────────────
# When enabled, the "Добавить в подписку" action wraps the subscription URL in
# a Happ-side install code (?InstallID=...) so Happ enforces the device cap via
# happ-proxy.com.  Requires a registered provider account on happ-proxy.com.
# Leave HAPP_LIMITED_LINKS_ENABLED unset (or false) to disable entirely.
#
# WARNING: API shape (endpoint, field names) is ASSUMED — validate against
# official Happ documentation before treating device-cap enforcement as
# guaranteed.  Requires a real 2-device test (limit=1) to confirm.
#
# HAPP_LIMITED_LINKS_ENABLED=true
# HAPP_PROVIDER_CODE=your_provider_code_here
# HAPP_AUTH_KEY=your_auth_key_here
# HAPP_API_URL=https://happ-proxy.com    # override only for testing

# ── Xray per-device revocation ────────────────────────────────────────────────
#
# XRAY_CLIENTS_CONFIG_PATH: container-side path where the app writes the active
# clients JSON array. The data/ directory is bind-mounted, so the host sees this
# file at /opt/shashkoffvpn/data/xray-clients.json (adjust to your deploy path).
#
XRAY_CLIENTS_CONFIG_PATH=/app/data/xray-clients.json
#
# ── Reload mode: Docker deployment (recommended) ──────────────────────────────
# The app runs in Docker and cannot call systemctl on the host directly.
# Use a systemd path unit on the host instead — it watches xray-clients.json
# via inotify and triggers shashkoffvpn-reload-xray automatically.
#
# Setup (one-time, on the host):
#   sudo cp deploy/shashkoffvpn-reload-xray.sh /usr/local/bin/shashkoffvpn-reload-xray
#   sudo cp deploy/shashkoffvpn-merge-xray-clients.py /usr/local/lib/shashkoffvpn-merge-xray-clients.py
#   sudo chmod +x /usr/local/bin/shashkoffvpn-reload-xray
#   sudo cp deploy/shashkoffvpn-xray-watcher.path /etc/systemd/system/
#   sudo cp deploy/shashkoffvpn-xray-watcher.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now shashkoffvpn-xray-watcher.path
#
# With this setup: leave XRAY_RELOAD_COMMAND unset (or empty).
# Set XRAY_RELOAD_VIA_WATCHER=true so the app knows reload is handled
# externally and suppresses the misleading "not reloaded" warning.
# XRAY_RELOAD_COMMAND=
XRAY_RELOAD_VIA_WATCHER=true
#
# ── Reload mode: non-Docker deployment (app on host) ─────────────────────────
# If the app runs directly on the host (not in Docker), the reload script
# can be called directly because app and Xray share the same host.
#
# XRAY_RELOAD_COMMAND=/usr/local/bin/shashkoffvpn-reload-xray
# XRAY_RELOAD_TIMEOUT_SECONDS=15

# ── Xray traffic stats (optional) ────────────────────────────────────────────
#
# When set, the app queries the Xray StatsService gRPC API at this address
# to report real total traffic in the user cabinet and Happ subscription-userinfo.
#
# Xray must be configured with stats enabled in config.base.json — see
# the "Enabling Xray stats" section in CLAUDE.md for the required JSON blocks.
#
# Docker deployment: Xray runs on the host; the app is in a container.
# The address must be reachable from inside the container.
#   - If Xray API inbound listens on 0.0.0.0:10085 on the host:
#       XRAY_API_ADDR=172.17.0.1:10085   (typical Docker bridge gateway)
#   - Or use host.docker.internal:10085 on Docker Desktop (Mac/Windows).
#
# Non-Docker (app on host):
#   XRAY_API_ADDR=127.0.0.1:10085
#
# Leave unset to disable stats — cabinet shows "N/A" for traffic.
# XRAY_API_ADDR=127.0.0.1:10085

# ── Temporary diagnostics (remove when done) ──────────────────────────────────
# When true, every /{token} Happ request is logged in full (headers, query
# params, client IP) to the root logger at WARNING level.
# Grep logs for [HAPP-DIAG] to find the output.
# Use only while investigating what Happ sends on subscription import/refresh.
# Remove this line (and DEBUG_HAPP_SUB_REQUESTS from config.py / profile.py)
# once the investigation is complete.
# DEBUG_HAPP_SUB_REQUESTS=true
